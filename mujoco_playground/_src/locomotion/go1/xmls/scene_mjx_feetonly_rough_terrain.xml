<mujoco model="go1 feet only rough terrain scene">
  <include file="go1_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="0.6" condim="3"/>
    
    <!-- Long walls that force climbing - no way around -->
    <!-- Wall 1: Forward blocking path -->
    <body name="wall1" pos="1.5 0 0.1">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="0.3 10.0 0.1"/>
    </body>
    
    <!-- Wall 2: Backward blocking path -->
    <body name="wall2" pos="-1.5 0 0.08">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="0.3 10.0 0.08"/>
    </body>
    
    <!-- Wall 3: Left side blocking -->
    <body name="wall3" pos="0 3.0 0.12">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="10.0 0.3 0.12"/>
    </body>
    
    <!-- Wall 4: Right side blocking -->
    <body name="wall4" pos="0 -3.0 0.09">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="10.0 0.3 0.09"/>
    </body>
    
    <!-- Additional crossing walls for more climbing practice -->
    <body name="wall5" pos="3.5 0 0.1">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="0.2 8.0 0.1"/>
    </body>
    
    <body name="wall6" pos="-3.5 0 0.07">
      <geom contype="1" conaffinity="0" friction="1 0.005 0.0001" rgba="0.6 0.6 0.6 1" type="box" size="0.2 8.0 0.07"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="
    0 0 0.278
    1 0 0 0
    0.1 0.9 -1.8
    -0.1 0.9 -1.8
    0.1 0.9 -1.8
    -0.1 0.9 -1.8"
      ctrl="0.1 0.9 -1.8 -0.1 0.9 -1.8 0.1 0.9 -1.8 -0.1 0.9 -1.8"/>
    <key name="home_higher" qpos="0 0 0.35 1 0 0 0 0 0.82 -1.63 0 0.82 -1.63 0 0.82 -1.63 0 0.82 -1.63"
      ctrl="0 0.82 -1.63 0 0.82 -1.63 0 0.82 -1.63 0 0.82 -1.63"/>
  </keyframe>
</mujoco>
